---
import BaseLayout from '../layouts/BaseLayout.astro';
import RegisterForm from '../components/auth/RegisterForm.tsx';
import { getTranslations, getLocalePath, type Locale } from '../i18n/ui';

const locale: Locale = 'en';
const t = getTranslations(locale);
---

<BaseLayout
  locale={locale}
  title="Sign Up — ForgeGaming"
  description="Create your free ForgeGaming account and train all 8 ability dimensions"
>
  <section class="auth-page">
    <div class="auth-card">
      <h1 class="auth-title">{t.auth.registerTitle}</h1>
      <p class="auth-subtitle">{t.auth.registerSubtitle}</p>
      <RegisterForm
        client:load
        locale={locale}
        translations={t.auth}
        loginPath={getLocalePath(locale, '/login')}
        dashboardPath={getLocalePath(locale, '/dashboard')}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 56px - 100px);
    padding: 80px 24px 40px;
  }
  .auth-card {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    padding: 40px;
    width: 100%;
    max-width: 420px;
  }
  .auth-title {
    font-family: Impact, 'Oswald', sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 4px;
  }
  .auth-subtitle {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 28px;
  }
</style>
