---
import BaseLayout from '../layouts/BaseLayout.astro';
import Dashboard from '../components/dashboard/Dashboard.tsx';
import { getTranslations, getLocalePath, type Locale } from '../i18n/ui';

const locale: Locale = 'en';
const t = getTranslations(locale);

const dimensions = [
  {
    id: 1,
    key: 'd1',
    icon: '⚡',
    name: t.dimensions.d1.name,
    type: t.dimensions.d1.type,
    desc: t.dimensions.d1.desc,
  },
  {
    id: 2,
    key: 'd2',
    icon: '🎯',
    name: t.dimensions.d2.name,
    type: t.dimensions.d2.type,
    desc: t.dimensions.d2.desc,
  },
  {
    id: 3,
    key: 'd3',
    icon: '📡',
    name: t.dimensions.d3.name,
    type: t.dimensions.d3.type,
    desc: t.dimensions.d3.desc,
  },
  {
    id: 4,
    key: 'd4',
    icon: '👁',
    name: t.dimensions.d4.name,
    type: t.dimensions.d4.type,
    desc: t.dimensions.d4.desc,
  },
  {
    id: 5,
    key: 'd5',
    icon: '🔵',
    name: t.dimensions.d5.name,
    type: t.dimensions.d5.type,
    desc: t.dimensions.d5.desc,
  },
  {
    id: 6,
    key: 'd6',
    icon: '🧠',
    name: t.dimensions.d6.name,
    type: t.dimensions.d6.type,
    desc: t.dimensions.d6.desc,
  },
  {
    id: 7,
    key: 'd7',
    icon: '🔀',
    name: t.dimensions.d7.name,
    type: t.dimensions.d7.type,
    desc: t.dimensions.d7.desc,
  },
  {
    id: 8,
    key: 'd8',
    icon: '⚔️',
    name: t.dimensions.d8.name,
    type: t.dimensions.d8.type,
    desc: t.dimensions.d8.desc,
  },
];
---

<BaseLayout
  locale={locale}
  title="Dashboard — ForgeGaming"
  description="Your training command center"
>
  <Dashboard
    client:load
    locale={locale}
    translations={t.dashboard}
    dimensions={dimensions}
    loginPath={getLocalePath(locale, '/login')}
    logoutLabel={t.nav.logout}
    testPath={getLocalePath(locale, '/train/d1')}
    trainEntryPath={getLocalePath(locale, '/train/d1')}
    homePath={getLocalePath(locale)}
    getDimensionPath={(id: number) => getLocalePath(locale, `/train/d${id}`)}
  />
</BaseLayout>

<style>
  :global(.dashboard) {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px 40px;
  }
  :global(.dashboard-loading) {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  :global(.loading-spinner) {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border-soft);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  :global(.dash-header) {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 32px;
  }
  :global(.dash-welcome) {
    font-family: Impact, 'Oswald', sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
  :global(.user-name) {
    color: var(--accent);
  }
  :global(.dash-subtitle) {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-top: 4px;
  }
  :global(.logout-btn) {
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid var(--border-soft);
    background: transparent;
    color: var(--text-dim);
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  :global(.logout-btn:hover) {
    border-color: var(--accent);
    color: var(--accent);
  }

  :global(.dash-actions) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 40px;
  }
  :global(.action-card) {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
    border-radius: 6px;
    border: 1px solid var(--border-soft);
    background: var(--bg-card);
    text-decoration: none;
    transition: all 0.2s;
  }
  :global(.action-card:hover) {
    border-color: var(--border);
    transform: translateY(-2px);
  }
  :global(.action-test:hover) {
    border-color: var(--accent);
  }
  :global(.action-train:hover) {
    border-color: var(--gold);
  }
  :global(.action-icon) {
    font-size: 1.8rem;
  }
  :global(.action-title) {
    font-weight: 700;
    font-size: 1rem;
  }
  :global(.action-desc) {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-top: 2px;
  }

  :global(.section-h) {
    font-family: Impact, 'Oswald', sans-serif;
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 16px;
  }

  :global(.dim-grid) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin-bottom: 40px;
  }
  :global(.dim-item) {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 6px;
    padding: 16px;
    transition: all 0.2s;
  }
  :global(.dim-item:hover) {
    border-color: var(--border);
  }
  :global(.dim-item-top) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  :global(.dim-item-icon) {
    font-size: 1.5rem;
  }
  :global(.dim-item-id) {
    font-family: Impact, sans-serif;
    font-size: 0.65rem;
    color: var(--accent);
    letter-spacing: 0.1em;
  }
  :global(.dim-item-name) {
    font-weight: 700;
    font-size: 0.9rem;
  }
  :global(.dim-item-type) {
    font-size: 0.65rem;
    color: var(--text-dim);
    margin: 2px 0 10px;
  }
  :global(.dim-item-stats) {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    padding: 8px 0;
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
  }
  :global(.stat-item) {
    display: flex;
    flex-direction: column;
  }
  :global(.stat-label) {
    font-size: 0.65rem;
    color: var(--text-dim);
  }
  :global(.stat-value) {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-dim);
  }
  :global(.dim-item-actions) {
    display: flex;
    gap: 6px;
  }
  :global(.dim-btn) {
    flex: 1;
    text-align: center;
    padding: 6px;
    border-radius: 3px;
    font-size: 0.78rem;
    font-weight: 600;
    transition: all 0.2s;
  }
  :global(.dim-btn-train) {
    background: var(--accent);
    color: #fff;
  }
  :global(.dim-btn-train:hover) {
    box-shadow: 0 0 10px rgba(255, 69, 0, 0.4);
  }
  :global(.dim-btn-test) {
    border: 1px solid var(--border-soft);
    color: var(--text-dim);
  }
  :global(.dim-btn-test:hover) {
    border-color: var(--gold);
    color: var(--gold);
  }

  :global(.empty-sessions) {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 6px;
    padding: 40px;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    :global(.dim-grid) {
      grid-template-columns: repeat(2, 1fr);
    }
    :global(.dash-actions) {
      grid-template-columns: 1fr;
    }
  }
</style>
