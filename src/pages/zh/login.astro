---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoginForm from '../../components/auth/LoginForm.tsx';
import { getTranslations, getLocalePath, type Locale } from '../../i18n/ui';

const locale: Locale = 'zh';
const t = getTranslations(locale);
---

<BaseLayout locale={locale} title="登录 — ForgeGaming" description="登录你的 ForgeGaming 训练账号">
  <section class="auth-page">
    <div class="auth-card">
      <h1 class="auth-title">{t.auth.loginTitle}</h1>
      <p class="auth-subtitle">{t.auth.loginSubtitle}</p>
      <LoginForm
        client:load
        locale={locale}
        translations={t.auth}
        signupPath={getLocalePath(locale, '/register')}
        dashboardPath={getLocalePath(locale, '/dashboard')}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 56px - 100px);
    padding: 80px 24px 40px;
  }
  .auth-card {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    padding: 40px;
    width: 100%;
    max-width: 420px;
  }
  .auth-title {
    font-family: Impact, 'Oswald', sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 4px;
  }
  .auth-subtitle {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 28px;
  }
</style>
