---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoginForm from '../../components/auth/LoginForm.tsx';
import { getTranslations, getLocalePath, type Locale } from '../../i18n/ui';

const locale: Locale = 'zh';
const t = getTranslations(locale);
---

<BaseLayout locale={locale} title="登录 — ForgeGaming" description="登录你的 ForgeGaming 训练账号">
  <section class="auth-page">
    <div class="auth-card">
      <h1 class="auth-title">{t.auth.loginTitle}</h1>
      <p class="auth-subtitle">{t.auth.loginSubtitle}</p>
      <LoginForm
        client:load
        locale={locale}
        translations={t.auth}
        signupPath={getLocalePath(locale, '/register')}
        dashboardPath={getLocalePath(locale, '/dashboard')}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 56px - 100px);
    padding: 80px 24px 40px;
  }
  .auth-card {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    padding: 40px;
    width: 100%;
    max-width: 420px;
  }
  .auth-title {
    font-family: Impact, 'Oswald', sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 4px;
  }
  .auth-subtitle {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 28px;
  }
  :global(.auth-form) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  :global(.oauth-btn) {
    width: 100%;
    padding: 10px 16px;
    border-radius: 4px;
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid var(--border-soft);
    background: var(--bg-card-solid);
    color: var(--text);
    cursor: pointer;
    transition: all 0.2s;
  }
  :global(.oauth-btn:hover:not(:disabled)) {
    border-color: var(--border);
  }
  :global(.oauth-btn:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.oauth-github:hover:not(:disabled)) {
    border-color: var(--accent);
  }
  :global(.oauth-google:hover:not(:disabled)) {
    border-color: var(--gold);
  }
  :global(.divider) {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-dim);
    font-size: 0.8rem;
    margin: 4px 0;
  }
  :global(.divider::before),
  :global(.divider::after) {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-soft);
  }
  :global(.divider span) {
    padding: 0 4px;
  }
  :global(.field) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  :global(.field label) {
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  :global(.field input) {
    padding: 10px 14px;
    border-radius: 4px;
    border: 1px solid var(--border-soft);
    background: var(--bg-card-solid);
    color: var(--text);
    font-size: 0.9rem;
    transition: border-color 0.2s;
  }
  :global(.field input:focus) {
    outline: none;
    border-color: var(--accent);
  }
  :global(.error-msg) {
    color: #ff4444;
    font-size: 0.82rem;
    padding: 4px 0;
  }
  :global(.error-msg.error-not_confirmed) {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  :global(.resend-btn) {
    background: none;
    border: none;
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
  }
  :global(.resend-btn:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.confirm-sent) {
    color: var(--gold);
    font-size: 0.8rem;
  }
  :global(.verified-notice) {
    color: var(--gold);
    background: rgba(255, 215, 0, 0.08);
    border: 1px solid rgba(255, 215, 0, 0.2);
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 0.85rem;
    text-align: center;
    margin-bottom: 16px;
  }
  :global(.submit-btn) {
    width: 100%;
    padding: 12px;
    border-radius: 4px;
    border: none;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 8px;
  }
  :global(.submit-btn:hover:not(:disabled)) {
    box-shadow: 0 0 16px rgba(255, 69, 0, 0.4);
  }
  :global(.submit-btn:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.switch-link) {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-top: 8px;
  }
  :global(.switch-link a) {
    color: var(--gold);
    font-weight: 600;
  }
  :global(.pref-section) {
    margin: 8px 0;
  }
  :global(.pref-title) {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 2px;
  }
  :global(.pref-subtitle) {
    font-size: 0.8rem;
    color: var(--text-dim);
    margin-bottom: 10px;
  }
  :global(.pref-options) {
    display: flex;
    gap: 8px;
  }
  :global(.pref-btn) {
    flex: 1;
    padding: 8px;
    border-radius: 4px;
    border: 1px solid var(--border-soft);
    background: var(--bg-card-solid);
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  :global(.pref-btn.active) {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-dim);
  }
</style>
