---
import BaseLayout from '../layouts/BaseLayout.astro';
import ForgotPasswordForm from '../components/auth/ForgotPasswordForm.tsx';
import { getTranslations, getLocalePath, type Locale } from '../i18n/ui';

const locale: Locale = 'en';
const t = getTranslations(locale);
---

<BaseLayout
  locale={locale}
  title="Forgot Password — ForgeGaming"
  description="Reset your ForgeGaming account password"
>
  <section class="auth-page">
    <div class="auth-card">
      <h1 class="auth-title">{t.auth.forgotPassword}</h1>
      <p class="auth-subtitle">{t.auth.forgotDesc}</p>
      <ForgotPasswordForm
        client:load
        locale={locale}
        translations={t.auth}
        loginPath={getLocalePath(locale, '/login')}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 56px - 100px);
    padding: 80px 24px 40px;
  }
  .auth-card {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    padding: 40px;
    width: 100%;
    max-width: 420px;
  }
  .auth-title {
    font-family: Impact, 'Oswald', sans-serif;
    font-size: 1.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 4px;
  }
  .auth-subtitle {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 28px;
  }
  :global(.forgot-wrapper) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  :global(.forgot-form) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  :global(.forgot-title) {
    font-family: Impact, 'Oswald', sans-serif;
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0 0 4px;
  }
  :global(.forgot-desc) {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin: 0 0 12px;
  }
  :global(.form-group) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  :global(.form-group label) {
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  :global(.form-group input) {
    padding: 10px 14px;
    border-radius: 4px;
    border: 1px solid var(--border-soft);
    background: var(--bg-card-solid);
    color: var(--text);
    font-size: 0.9rem;
    transition: border-color 0.2s;
  }
  :global(.form-group input:focus) {
    outline: none;
    border-color: var(--accent);
  }
  :global(.code-input) {
    letter-spacing: 8px;
    text-align: center;
    font-size: 1.4rem;
    font-weight: 700;
  }
  :global(.form-error) {
    color: #ff4444;
    font-size: 0.82rem;
    padding: 4px 0;
  }
  :global(.form-info) {
    color: var(--gold);
    font-size: 0.82rem;
    padding: 4px 0;
  }
  :global(.btn-submit) {
    width: 100%;
    padding: 12px;
    border-radius: 4px;
    border: none;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 8px;
    text-align: center;
    text-decoration: none;
  }
  :global(.btn-submit:hover:not(:disabled)) {
    box-shadow: 0 0 16px rgba(255, 69, 0, 0.4);
  }
  :global(.btn-submit:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.btn-submit.btn-primary) {
    background: var(--accent);
  }
  :global(.resend-row) {
    text-align: center;
    margin-top: 4px;
  }
  :global(.btn-resend) {
    background: none;
    border: none;
    color: var(--gold);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    padding: 4px 0;
    text-decoration: underline;
  }
  :global(.btn-resend:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
  }
  :global(.forgot-footer) {
    text-align: center;
    margin-top: 8px;
  }
  :global(.back-link) {
    color: var(--gold);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
  :global(.back-link-btn) {
    background: none;
    border: none;
    color: var(--gold);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
  }
  :global(.dev-code-notice) {
    background: rgba(255, 215, 0, 0.08);
    border: 1px dashed rgba(255, 215, 0, 0.3);
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 0.8rem;
    color: var(--gold);
    text-align: center;
  }
  :global(.forgot-done) {
    text-align: center;
  }
</style>
